# =================================================================
# OneClass Backend Environment Variables Template
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# =================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/oneclass_db
DB_USERNAME=oneclass_user
DB_PASSWORD=oneclass123

# Mail Configuration (SMTP / Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-app-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# JWT Security Configuration (Use a strong secret in production)
JWT_SECRET=ReplaceThisWithALongRandomBase64SecretKeyForJwtSigning123456
JWT_EXPIRATION_MS=86400000

# OTP Expiration (in minutes)
OTP_EXPIRATION_MINUTES=10

# LiveKit Video & Audio Calling (Optional in local development)
# LiveKit Cloud format: wss://<project-subdomain>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

